{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-release-version.mjs ${nextRelease.version} && yarn install --mode update-lockfile"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/durable-work"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/data-sync-durable"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["packages/durable-work/package.json", "packages/data-sync-durable/package.json", "yarn.lock"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
