{
  "name": "open-mercato-durable",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "harness",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:sandbox": "turbo run build --filter='./apps/sandbox'",
    "build": "yarn build:packages && yarn build:sandbox",
    "gen:mirror": "yarn workspace @fullstackhouse/open-mercato-data-sync-durable gen:mirror",
    "gen:mirror:check": "yarn workspace @fullstackhouse/open-mercato-data-sync-durable gen:mirror --check",
    "generate": "yarn workspace sandbox generate",
    "initialize": "yarn workspace sandbox initialize",
    "reinstall": "yarn workspace sandbox reinstall",
    "mercato": "yarn workspace sandbox mercato",
    "dev": "yarn workspace sandbox dev",
    "dev:worker": "yarn workspace sandbox mercato durable_work worker",
    "start": "turbo run start --filter='./apps/sandbox'",
    "typecheck": "turbo run typecheck --filter='./packages/*' --filter='./harness' --filter='./apps/sandbox'",
    "lint": "turbo run lint --filter='./packages/*' --filter='./harness'",
    "test": "turbo run test --filter='./packages/*'",
    "test:harness": "yarn workspace @fullstackhouse/durable-harness test",
    "test:integration": "playwright test --config .ai/qa/tests/playwright.config.ts",
    "test:integration:ephemeral": "yarn workspace sandbox test:integration:ephemeral",
    "test:integration:ephemeral:start": "yarn workspace sandbox test:integration:ephemeral:start",
    "pack:packages": "./scripts/pack-packages.sh",
    "publish:preview": "./scripts/publish-preview.sh",
    "registry:up": "docker compose up -d verdaccio",
    "registry:down": "docker compose stop verdaccio",
    "registry:ping": "./scripts/registry/ping.sh",
    "registry:setup-user": "./scripts/registry/setup-user.sh",
    "registry:whoami": "./scripts/registry/whoami.sh",
    "platform:sync": "node scripts/platform-sync.mjs",
    "platform:sync:check": "node scripts/platform-sync.mjs --check",
    "sync:sandbox": "./scripts/sync-sandbox.sh",
    "check:dep-versions": "tsx scripts/check-dep-versions.ts",
    "clean:generated": "./scripts/clean-generated.sh",
    "clean:packages": "./scripts/clean-packages.sh",
    "clean": "yarn clean:generated && yarn clean:packages",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build:packages && changeset publish",
    "verify": "yarn install --immutable && yarn build:packages && yarn gen:mirror:check && yarn workspace sandbox generate && yarn build:packages && yarn typecheck && yarn lint && yarn test && yarn check:dep-versions && yarn platform:sync:check",
    "verify:all": "yarn verify && yarn test:harness && yarn test:integration:ephemeral",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@open-mercato/scheduler": "0.7.0",
    "@open-mercato/search": "0.7.0",
    "@playwright/test": "^1.58.2",
    "@semantic-release/exec": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "globals": "^16.0.0",
    "semantic-release": "^24.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  }
}
